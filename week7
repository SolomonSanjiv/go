package main
import "fmt"
func main() {
    var str string
    fmt.Scan(&str)
    k := 0
    i := 0
    j := len(str) - 1
    for i <= j {
        if str[i] == str[j] {
            i++
            j--
        } else {
            k++
            break
        }
    }
    if k == 0 {
        fmt.Println("Palindrome")
    } else {
        fmt.Println("not palindrome")
    }
}
