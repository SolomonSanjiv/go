package main
import "fmt"
func main() {
    fmt.Println("Enter the number of elements")
    var n int
    fmt.Scan(&n)
    var arr [100]int
    fmt.Println("Enter the array elements:")
    for i := 0; i < n; i++ {
        fmt.Scan(&arr[i])
    }
    fmt.Println("Array after removing duplicate elements:")
    for i := 0; i < n; i++ {
        duplicate := false
        for j := 0; j < i; j++ {
            if arr[i] == arr[j] {
                duplicate = true
                break
            }
        }
        if !duplicate {
            fmt.Print(arr[i], " ")
        }
    }
}
